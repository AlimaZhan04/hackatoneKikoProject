{
  "name": "kiko-project-work",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "server": "node --env-file=.env server/index.mjs",
    "db:migrate": "node --env-file=.env server/migrate.mjs",
    "db:seed": "node --env-file=.env server/seed.mjs",
    "db:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1",
    "build": "node node_modules/vite/bin/vite.js build",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --env-file=.env --test tests/api.integration.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^5.11.16",
    "@mui/material": "^5.11.16",
    "axios": "^1.3.4",
    "bootstrap": "^5.2.3",
    "express": "^5.3.0",
    "mdb-react-ui-kit": "^6.0.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.2",
    "react-credit-cards": "npm:react-credit-cards-2@^1.1.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "swiper": "^14.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "vite": "^7.3.8"
  }
}
